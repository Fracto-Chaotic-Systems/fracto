{
  "name": "fracto",
  "version": "1.0.0",
  "description": "Main server for the fracto mediaplex",
  "homepage": "https://github.com/Fracto-Chaotic-Systems/fracto#readme",
  "bugs": {
    "url": "https://github.com/Fracto-Chaotic-Systems/fracto/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fracto-Chaotic-Systems/fracto.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --max-old-space-size=16384 index.js",
    "check": "npm run check:syntax && npm run db:validate && npm test",
    "check:syntax": "node scripts/check_syntax.js",
    "test": "node --test test/math.test.js test/tile_paths.test.js test/health.integration.test.js",
    "test:docker": "node scripts/docker_smoke_test.js",
    "start:check": "node scripts/startup_preflight.js",
    "prestart": "node scripts/update_repositories.js",
    "update:repos": "node scripts/update_repositories.js",
    "tiles:index": "node --max-old-space-size=16384 scripts/build_tile_index.js",
    "tiles:refresh": "node --max-old-space-size=16384 scripts/refresh_tile_index.js",
    "tiles:backup": "node --max-old-space-size=16384 servers/fracto-tiles-server/backup.js",
    "tiles:migrate:index": "node scripts/migrate_tile_cache_index.js",
    "tiles:status": "node scripts/tile_cache_status.js",
    "tiles:benchmark": "node scripts/benchmark_canvas_render.js",
    "tiles:benchmark:legacy": "node scripts/benchmark_canvas_render.js legacy",
    "tiles:benchmark:turbo": "node scripts/benchmark_canvas_render.js turbo",
    "data:circuitry": "node scripts/circuitry_harness.js",
    "data:orbital:newton": "node scripts/orbital_newton_harness.js",
    "data:orbital:newton:benchmark": "node scripts/benchmark_orbital_newton.js",
    "data:orbital:detector:benchmark": "node scripts/benchmark_orbital_detector.js",
    "data:orbital:pyramid:benchmark": "node scripts/benchmark_orbital_detector.js --mode pyramid_only",
    "data:orbital:main-cardioid:benchmark": "node scripts/benchmark_main_cardioid_detector.js",
    "data:spectral:benchmark": "node scripts/benchmark_spectral_analysis.js",
    "db:init": "node scripts/initialize_database.js",
    "db:migrate": "node scripts/initialize_database.js",
    "db:validate": "node scripts/validate_migrations.js",
    "format": "node scripts/format_repositories.js write",
    "format:check": "node scripts/format_repositories.js check"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "chalk": "^5.6.2",
    "csv-parser": "^3.2.0",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "mathjs": "15.2.0",
    "mysql2": "^3.16.0",
    "node-fetch": "^3.3.2",
    "path": "^0.12.7",
    "process": "^0.11.10",
    "stream-json": "^2.1.0",
    "styled-components": "^6.3.11",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
