# HTTP reverse proxy for a trusted Windows development lab.
# Keep this listener private to the lab network and use the lab-only bypass
# settings documented in deploy/WINDOWS_LAB.md. Do not use this for EC2.
server {
    # Listens on all host interfaces; restrict inbound TCP 3000 with the
    # Windows Firewall to the trusted lab subnet.
    listen 3000;
    server_name _;

    client_max_body_size 2g;
    proxy_connect_timeout 30s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # The trailing slash strips /api/<service>/ before forwarding.
    location ^~ /api/main/ {
        proxy_pass http://127.0.0.1:3001/;
    }
    location ^~ /api/data/ {
        proxy_pass http://127.0.0.1:3002/;
    }
    location ^~ /api/asset/ {
        proxy_pass http://127.0.0.1:3003/;
    }
    location ^~ /api/tiles/ {
        proxy_pass http://127.0.0.1:3004/;
    }
    # Stream instrument uploads rather than spooling each file to proxy disk.
    location ^~ /api/admin/instrument-transfer/ {
        client_max_body_size 512m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:3005/instrument-transfer/;
    }
    location ^~ /api/admin/ {
        proxy_pass http://127.0.0.1:3005/;
    }

    # Never send an unknown API path to the React UI fallback.
    location ^~ /api/ai/ {
        # Lab browser authentication bypass must not expose machine inference.
        if ($uri ~* "^/api/ai/(?:inference|peer)(?:/|$)") { return 404; }
        proxy_pass http://127.0.0.1:3007/;
    }

    # Compatibility transport; application behavior belongs to the asset service.
    location ^~ /api/environment-catalog {
        client_max_body_size 128m;
        proxy_request_buffering off;
        proxy_read_timeout 180s;
        proxy_pass http://127.0.0.1:3006;
    }

    # Dedicated stage planning capability; machine inference remains blocked.
    location = /api/component-construction/plan {
        client_max_body_size 1m;
        proxy_read_timeout 180s;
        proxy_pass http://127.0.0.1:3007/construction/plan;
    }

    location ^~ /api/component-documents {
        client_max_body_size 1m;
        proxy_pass http://127.0.0.1:3006;
    }

    location ^~ /api/ {
        return 404;
    }

    location / {
        proxy_pass http://127.0.0.1:3006;
    }
}
